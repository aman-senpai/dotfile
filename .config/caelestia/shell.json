{
    "appearance": {
        "font": {
            "clock": "Rubik",
            "scale": 0.9,
            "workspaces": "Rubik"
        },
        "padding": {
            "scale": 0.8
        },
        "spacing": {
            "scale": 0.8
        },
        "transparency": {
            "enabled": false
        }
    },
    "enabled": true,
    "launcher": {
        "vimKeybinds": false
    },
    "lock": {
        "useWallpaper": true
    },
    "paths": {
        "wallpaperDir": "~/Pictures/Wallpapers"
    },
    "services": {
        "useFahrenheit": false,
        "useFahrenheitPerformance": false
    }
}
